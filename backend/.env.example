PROJECT_NAME="Zuccano Corporate API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="zuccano_db"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@zuccano.com"
EMAILS_FROM_NAME="Zuccano Group"
